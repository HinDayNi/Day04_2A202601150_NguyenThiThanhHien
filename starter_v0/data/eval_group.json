{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "Bộ 10 test case do nhóm tự thiết kế về tra cứu tin tuyển dụng và Job Description (JD) bằng tool job_search (5 single-turn và 5 multi-turn).",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_job_search_routing",
      "phase": "B",
      "suite": "group",
      "query": "Tìm bài đăng tuyển dụng (JD) vị trí AI Engineer ở Việt Nam",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "job_search",
            "args": {
              "query": "AI Engineer in Vietnam"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_job_search",
        "difficulty": "easy",
        "what_it_tests": "Tra cứu tin tuyển dụng JD AI Engineer ở Việt Nam → gọi tool job_search."
      }
    },
    {
      "id": "G02_job_search_location_arg",
      "phase": "B",
      "suite": "group",
      "query": "Tìm việc làm Senior Data Scientist tại Ho Chi Minh",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "job_search",
            "args": {
              "query": "Senior Data Scientist in Ho Chi Minh"
            }
          }
        ]
      },
      "metadata": {
        "skill": "arg_job_search_query",
        "difficulty": "medium",
        "what_it_tests": "Trích xuất từ khóa vị trí kèm địa điểm vào tham số query của job_search."
      }
    },
    {
      "id": "G03_job_search_read_url",
      "phase": "B",
      "suite": "group",
      "query": "Tóm tắt giúp mình yêu cầu công việc trong JD bài tuyển dụng này: https://www.linkedin.com/jobs/view/12345678",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "fetch",
            "args": {
              "url": "https://www.linkedin.com/jobs/view/12345678"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_fetch_job_url",
        "difficulty": "easy",
        "what_it_tests": "Có đường dẫn URL bài tuyển dụng cụ thể → gọi fetch để đọc trang."
      }
    },
    {
      "id": "G04_job_search_missing_title",
      "phase": "B",
      "suite": "group",
      "query": "Tìm giúp mình các bài đăng tuyển dụng việc làm ở Hà Nội",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "skill": "clarify_missing_job_title",
        "difficulty": "medium",
        "what_it_tests": "Thiếu tên vị trí công việc (Job Title) cần tìm → gọi clarify hỏi lại người dùng."
      }
    },
    {
      "id": "G05_job_search_out_of_scope",
      "phase": "B",
      "suite": "group",
      "query": "Viết giúp mình một đoạn mã Python để cào dữ liệu JD tuyển dụng",
      "failure_type": "out_of_scope",
      "expect": {
        "no_tool": true,
        "behavior": "refuse"
      },
      "metadata": {
        "skill": "out_of_scope_coding_crawler",
        "difficulty": "easy",
        "what_it_tests": "Yêu cầu viết code crawler lập trình ngoài phạm vi research → không gọi tool, từ chối."
      }
    },
    {
      "id": "GM01_job_search_location_update",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tìm tin tuyển dụng AI Engineer"
        },
        {
          "role": "user",
          "content": "Ở khu vực Ho Chi Minh nhé"
        }
      ],
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "job_search",
            "args": {
              "query": "AI Engineer in Ho Chi Minh"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_job_search_location",
        "difficulty": "medium",
        "what_it_tests": "2 turns: giữ query 'AI Engineer' từ lượt 1 và kết hợp địa điểm 'Ho Chi Minh' ở lượt 2."
      }
    },
    {
      "id": "GM02_job_search_title_correction",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tìm tin tuyển dụng vị trí Data Analyst"
        },
        {
          "role": "user",
          "content": "À nhầm, đổi sang vị trí Data Engineer"
        }
      ],
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "job_search",
            "args": {
              "query": "Data Engineer"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_job_title_correction",
        "difficulty": "medium",
        "what_it_tests": "2 turns: đính chính tên vị trí tuyển dụng từ Data Analyst sang Data Engineer."
      }
    },
    {
      "id": "GM03_job_search_clarify_then_fill",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tìm bài đăng tuyển dụng việc làm"
        },
        {
          "role": "user",
          "content": "Cho vị trí Solution Architect"
        }
      ],
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "job_search",
            "args": {
              "query": "Solution Architect"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_job_fill_title",
        "difficulty": "medium",
        "what_it_tests": "2 turns: bổ sung tên vị trí công việc ở lượt 2 sau khi được hỏi lại."
      }
    },
    {
      "id": "GM04_job_search_read_url_multiturn",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tóm tắt thông tin tuyển dụng này hộ mình"
        },
        {
          "role": "user",
          "content": "https://www.linkedin.com/jobs/view/98765432"
        }
      ],
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "fetch",
            "args": {
              "url": "https://www.linkedin.com/jobs/view/98765432"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_job_read_url",
        "difficulty": "medium",
        "what_it_tests": "2 turns: cung cấp URL ở lượt 2 → gọi fetch đọc URL bài tuyển dụng."
      }
    },
    {
      "id": "GM05_job_search_confirm_post",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Soạn và đăng thông tin tuyển dụng này lên Telegram channel"
        }
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_job_confirm_post",
        "difficulty": "medium",
        "what_it_tests": "Hành động đăng/gửi tin nhạy cảm → bắt buộc gọi clarify yes_no xin xác nhận."
      }
    }
  ]
}
